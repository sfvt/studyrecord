<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>My News App</title>
    <link rel="stylesheet" href="/stylesheet.css" />
  </head>
  <body>
    <aside class="sidebar-container min" id="sidebar"></aside>
    <main class="content-wrapper">
      <header class="header-section">
        <button type="button" class="menu-button">
          <span class="menu-icon">☰</span>
          <span class="menu-text">メニュー</span>
        </button>
        <h1>学習記録</h1>
      </header>

      <section class="learning-logger-section">
        <div class="select-watches">
          <button
            class="timer-button is-timer mode-target"
            data-mode="is-timer"
            id="timerBtn"
            type="button"
          >
            Timer
          </button>
          <button
            class="stopwatch-button mode-target"
            data-mode="is-stopwatch"
            id="stopwatchBtn"
            type="button"
          >
            StopWatch
          </button>
        </div>

        <div
          class="timer-container is-timer mode-target"
          data-mode="is-timer is-stopwatch"
          id="timerContainer"
        >
          <div class="time" id="timer">00:00:00</div>
        </div>

        <div class="timer-button-container">
          <button type="button">START</button>
          <button type="button">STOP</button>
          <button type="button" id="submit-button">SUBMIT</button>
        </div>

        <div class="select-subjects-container">
          <select class="select-subjects"></select>
          <button type="button" id="plus-subject-button">+</button>
        </div>
      </section>
    </main>
    <!-- 確認画面 モーダル -->
    <div class="modal hidden" id="study-modal">
      <div class="submit-modal-content">
        <h2>学習時間を記録しますか？</h2>
        <dl class="confirmation">
          <div class="row">
            <dt>今回の学習時間 :</dt>
            <dd id="studyTime"></dd>
          </div>
          <div class="row">
            <dt>教科 :</dt>
            <dd id="subject"></dd>
          </div>
        </dl>
        <div class="select-buttons">
          <button type="button" id="cancel-submit">キャンセル</button>
          <button type="button">送信</button>
        </div>
      </div>
    </div>
    <!-- 教科の登録画面　モーダル -->
    <div class="modal hidden" id="subject-modal">
      <div class="subject-modal-content">
        <h2>教科の追加</h2>
        <form action="/#" method="post" class="subject-form">
          <label for="subject"></label>
          <input
            name="subject"
            type="text"
            placeholder="教科名(国語・数学など)"
          />
          <div class="subject-bottons">
            <button type="button" id="cancel-add-subject">キャンセル</button>
            <button type="submit">送信</button>
          </div>
        </form>
      </div>
    </div>
    <script type="module" src="/main.js"></script>
  </body>
</html>
